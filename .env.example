# Kopiraj v .env in izpolni. .env se ne commita.

# Vreme (privzeto Maribor)
WEATHER_LAT=46.5547
WEATHER_LON=15.6459

# Mrežni pregled - Proxmox API (žeton z vlogo PVEAuditor, samo branje)
PVE_API_URL=https://192.168.1.10:8006
PVE_TOKEN_ID=hcc@pve!dashboard
PVE_TOKEN_SECRET=
# Proxmox ima samopodpisan certifikat
PVE_INSECURE_TLS=1

# IP LXC kontejnerja z Dockerjem (za povezave do objavljenih portov)
DOCKER_HOST_IP=192.168.1.51

# Google Calendar - service account: JSON ključ v eni vrstici; koledar deli z njegovim client_email
# ("Make changes to events"). Alternativa: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Ljubljana

# Škoda (uradni javni API). Ključ: aplikacija MyŠkoda → Manage API keys (https://go.skoda.eu/api-keys),
# izberi avto. Brez teh vrednosti kartica Car prikazuje demo podatke. Omejitev: 20 klicev/uro na VIN;
# API se kliče samo z gumbom "Refresh" na kartici (največ vsakih 30 s).
SKODA_API_KEY=
SKODA_VIN=
